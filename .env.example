APP_NAME="Trinix Admission"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DISPLAY_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local quick start uses SQLite. Docker Compose and production use MySQL 8.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=admission
# DB_USERNAME=admission
# DB_PASSWORD=

# Several app servers must share sessions, cache and locks: use redis outside quick local runs.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:8080,127.0.0.1,127.0.0.1:8000

CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Private files: "local" for development, "s3" for any S3-compatible store (AWS, MinIO, etc.).
PRIVATE_DISK_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admissions@example.test"
MAIL_FROM_NAME="${APP_NAME}"

INVITATION_EXPIRE_MINUTES=4320

# Load balancer addresses whose X-Forwarded-* headers are trusted (comma separated, or * behind a private network only).
TRUSTED_PROXIES=*

# Demo data (php artisan db:seed --class=DemoSeeder). Never used in production.
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=change-me-please-123

VITE_APP_NAME="${APP_NAME}"

# Virus scanning: clamav (production) or eicar (development only: flags the EICAR test file, nothing else)
DOCUMENT_SCANNER=eicar
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
