# Used by docker-compose.yml only. Never use these values in production.
APP_NAME="Trinix Admission"
APP_ENV=local
APP_KEY=base64:TE9DQUwtRE9DS0VSLUtFWS1OT1QtRk9SLVBST0QhISE=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_DISPLAY_TIMEZONE=Asia/Kolkata
LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=admission
DB_USERNAME=admission
DB_PASSWORD=admission

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SANCTUM_STATEFUL_DOMAINS=localhost:8080
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis

PRIVATE_DISK_DRIVER=s3
AWS_ACCESS_KEY_ID=admission
AWS_SECRET_ACCESS_KEY=admission-secret
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=admission-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="admissions@example.test"

TRUSTED_PROXIES=*
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=change-me-please-123

DOCUMENT_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
IMPORT_QUEUE=imports
